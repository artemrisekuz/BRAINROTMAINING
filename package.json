{
  "name": "brainrot-mining",
  "private": true,
  "version": "2.0.0",
  "description": "Brainrot Mining — Telegram Mini App case-opening game on Cloudflare Workers",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create brainrot-mining-db",
    "db:migrate:local": "wrangler d1 migrations apply brainrot-mining-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply brainrot-mining-db --remote",
    "db:migrate": "npm run db:migrate:remote",
    "webhook:set": "node scripts/set-webhook.js",
    "webhook:delete": "node scripts/delete-webhook.js",
    "start": "echo 'Use npm run dev for local development'",
    "start:site": "echo 'Replaced by Cloudflare Workers'",
    "start:bot": "echo 'Bot runs via webhook on Cloudflare Workers'"
  },
  "dependencies": {
    "grammy": "^1.46.0"
  },
  "devDependencies": {
    "wrangler": "^4.158.0"
  }
}
